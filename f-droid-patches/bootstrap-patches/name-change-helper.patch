--- a/packages/termux-auth/build.sh
+++ b/packages/termux-auth/build.sh
@@ -12,5 +12,11 @@
 TERMUX_PKG_REPLACES="termux-auth-dev"
 
 termux_step_pre_configure() {
+	. "$TERMUX_SCRIPTDIR/scripts/termux_generator_utils.sh"
+	for f in termux-auth.c termux-auth.h.in; do
+		if [ -f "$TERMUX_PKG_SRCDIR/$f" ]; then
+			replace_termux_name "$TERMUX_PKG_SRCDIR/$f" "$TERMUX_APP__PACKAGE_NAME"
+		fi
+	done
 	CPPFLAGS+=" -DTERMUX_HOME=\\\"${TERMUX_ANDROID_HOME}\\\" -DTERMUX_PREFIX=\\\"${TERMUX_PREFIX}\\\""
 }
